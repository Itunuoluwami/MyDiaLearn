<?xml version="1.0" encoding="utf-8"?>
<!--
  DiaLearn frontend on IIS (SmarterASP).

  Nitro's iis_node preset writes a web.config into .output/ that registers the
  iisnode module. SmarterASP does not use iisnode; it runs Node through
  httpPlatformHandler, and a site configured for iisnode answers 502 with no
  error page. The deploy workflow overwrites Nitro's file with this one.

  Everything is served by the Nitro server, public assets included. IIS cannot
  serve them directly here: httpPlatformHandler is registered at path="*", so
  it claims every request whatever the rewrite rules say.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />

    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>

    <httpPlatform processPath="node"
                  arguments="index.js"
                  startupTimeLimit="120"
                  startupRetryCount="2"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\log.txt">
      <environmentVariables>
        <!-- httpPlatformHandler picks a free port and proxies to it. -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <fileExtensions>
          <!-- Source maps and the stdout log are not for the public. -->
          <add fileExtension=".map" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
