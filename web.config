<?xml version="1.0" encoding="utf-8"?>
<!--
  DiaLearn API on IIS + iisnode (SmarterASP).

  Copied to the root of the deploy-api branch by .github/workflows/deploy.yml.
  Edit it here, not on the server: the next deploy overwrites the server copy.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />

    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!--
          Every request goes to Node, unconditionally. Unlike the frontend
          there are no static files to serve, and letting IIS serve files that
          exist on disk would expose .env, dist/ source maps and uploads.
        -->
        <rule name="api" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Belt and braces behind the rewrite above. -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="dist" />
          <add segment="iisnode" />
          <!-- App_Data is hidden by IIS already; uploads live under it. -->
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
        <!-- 25 MB: the largest upload the API accepts, plus headroom. -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>

    <!-- Let the API's own JSON errors through instead of IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <!--
      enableXFF: IIS appends the client address to X-Forwarded-For; main.ts
        trusts exactly that one hop for rate limiting.
      loggingEnabled=false: iisnode's log directory sits inside the site and
        would publish stdout, which can include request metadata.
      watchedFiles: a deploy that changes these restarts Node.
    -->
    <iisnode
      node_env="production"
      enableXFF="true"
      loggingEnabled="false"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      watchedFiles="web.config;index.js;.env"
    />
  </system.webServer>
</configuration>
