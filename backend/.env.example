# ============================================================
# DiaLearn backend — environment template
# ============================================================
# Copy to backend/.env and fill in. backend/.env is gitignored.
#
#   cp .env.example .env
#
# Validated at boot by src/config/env.validation.ts. The app refuses to start
# if a required value is missing or malformed.
#
# NOTHING HERE IS VITE_-PREFIXED, AND NOTHING HERE MAY BE. The frontend build
# inlines VITE_* variables into the browser bundle; DATABASE_URL, JWT_SECRET
# and SMTP_PASSWORD reaching it would publish them to every visitor.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development                  # development | test | staging | production
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:8080    # comma-separated, or * (never * in production)
LOG_LEVEL=debug                      # fatal|error|warn|info|debug|trace|silent

# ------------------------------------------------------------
# Database — PostgreSQL 18.x, external host
# ------------------------------------------------------------
# Host: pg8001.site4now.net:6432
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# URL-encode any reserved characters in the password (@ : / ? # [ ] %).
# The backend is the only application layer permitted to hold this.
DATABASE_URL=

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Minimum 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Optional. Falls back to JWT_SECRET, but a distinct value is preferred so a
# leaked access secret cannot also mint refresh tokens.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# Authentication behaviour
# ------------------------------------------------------------
# Public origin of the frontend. Used to build the links in verification and
# password-reset emails, so it must match what users actually browse to.
APP_URL=http://localhost:8080

# Supabase required email confirmation before sign-in; this preserves that.
# Set false only for local work where no mail is delivered.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Account-level lockout, on top of the IP-level throttler. Both are needed: the
# throttler stops one host hammering many accounts, this stops many hosts
# hammering one account.
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_MINUTES=15

# Refresh-token cookie. Secure is forced on when APP_ENV=production.
# Set COOKIE_DOMAIN only when the API and frontend share a parent domain.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# SMTP — DiaLearn's mail server (site4now)
# ------------------------------------------------------------
# Sending identity is info@mydialearn.com. The domain's DNS makes this
# deliverable: SPF `include:_spf.site4now.net` covers sending through site4now,
# and DMARC `p=reject` means the From address MUST be @mydialearn.com — any
# other domain is refused, not junked. So SMTP_USER and SMTP_FROM_EMAIL are the
# same @mydialearn.com mailbox.
#
# Ports, verified by probe on 2026-09-24:
#   mail5008.site4now.net:587   TLS submission (STARTTLS)   <- PRODUCTION
#   mail5008.site4now.net:465   implicit TLS
#   mail.mydialearn.com:8889    plain submission, no STARTTLS, CRAM-MD5 auth
#
# 587/465 were blocked from the dev machine's ISP, so this environment uses
# 8889 with CRAM-MD5 (below) — the password is challenge-response, not clear.
# In production prefer 587 with SMTP_SECURE=false and SMTP_REQUIRE_TLS=true.
#
# Port and TLS must agree or the connection hangs until timeout:
#   587 -> SMTP_SECURE=false, SMTP_REQUIRE_TLS=true   (STARTTLS)
#   465 -> SMTP_SECURE=true                            (implicit TLS)
#   8889-> SMTP_SECURE=false, SMTP_REQUIRE_TLS=false, SMTP_AUTH_METHOD=CRAM-MD5
SMTP_HOST=mail.mydialearn.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Empty lets nodemailer negotiate. Set CRAM-MD5 only on a non-TLS port so the
# password is never sent base64-in-clear.
SMTP_AUTH_METHOD=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DiaLearn
WEBMAIL_URL=https://mail5008.site4now.net

# ------------------------------------------------------------
# Integration adapters
# ------------------------------------------------------------
# Which implementation is bound to each port. See src/integrations/.
EMAIL_PROVIDER=log                   # smtp | log
PAYMENT_PROVIDER=simulated           # simulated — rejected when APP_ENV=production
# Secret the payment adapter verifies webhooks with (min 16 chars). Leave empty
# to refuse every webhook. Webhooks arrive at POST /api/payments/webhooks/<provider>.
PAYMENT_WEBHOOK_SECRET=
STORAGE_PROVIDER=unconfigured        # unconfigured — Supabase still owns storage
CLASSROOM_PROVIDER=none              # none — no video provider integrated

# ------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
