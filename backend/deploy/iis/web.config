<?xml version="1.0" encoding="utf-8"?>
<!--
  DiaLearn API on IIS (SmarterASP).

  SmarterASP runs Node through httpPlatformHandler, not iisnode. This file
  was iisnode's shape until the control panel rewrote it on the server; the
  panel's version is what actually works, so it is now the one in the repo.
  Getting this wrong is silent: IIS answers 502 and the only trace is the
  stdout log.

  Copied to the root of the deploy-api branch by .github/workflows/deploy.yml.
  Edit it here, not on the server: the next deploy overwrites the server copy.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />

    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>

    <!--
      processPath/arguments: index.js chdirs to the site root and loads
        dist/main.js.
      PORT: httpPlatformHandler picks a free port and proxies to it, so the
        app must bind that and nothing else. This is why the server .env has
        no PORT line.
      startupTimeLimit: NestJS has to build its module graph and Prisma has
        to reach a database on another host. 20s (the panel's default) is not
        enough on a cold shared app pool.
      stdoutLogFile: the only crash diagnostics there are. It lands in the
        site root, which the catch-all rewrite below keeps unservable.
    -->
    <httpPlatform processPath="node"
                  arguments="index.js"
                  startupTimeLimit="120"
                  startupRetryCount="2"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\log.txt">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <rewrite>
      <rules>
        <!--
          Every request goes to Node, unconditionally. Unlike the frontend
          there are no static files to serve, and letting IIS serve files that
          exist on disk would expose .env, dist/ source maps, the stdout log
          and uploads.
        -->
        <rule name="api" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Belt and braces behind the rewrite above. -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="dist" />
          <add segment="iisnode" />
          <!-- App_Data is hidden by IIS already; uploads live under it. -->
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".map" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
        <!-- 25 MB: the largest upload the API accepts, plus headroom. -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>

    <!-- Let the API's own JSON errors through instead of IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
