# ============================================================
# DIALEARN — ENVIRONMENT TEMPLATE
# ============================================================
# Copy to .env and fill in. .env is untracked and must stay that way.
#
#   cp .env.example .env
#
# ============================================================
# CURRENT STACK — SUPABASE
# ============================================================
# Removed once the NestJS backend owns all data access (migration Phase 6).

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only. Bypasses RLS entirely — never expose as VITE_*, never import
# client.server.ts at the top level of a route or *.functions.ts file.
SUPABASE_SERVICE_ROLE_KEY=



# ============================================================
# DIALEARN ENVIRONMENT CONFIGURATION
# ============================================================

NODE_ENV=
PORT=
API_PREFIX=


# ============================================================
# FRONTEND / CORS
# ============================================================

CORS_ORIGIN=

# Production example:
# CORS_ORIGIN=https://your-dialearn-frontend-domain.com


# ============================================================
# POSTGRESQL
# ============================================================

DATABASE_URL=


# Individual database variables
# Keep these available if the backend configuration needs them separately.

DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=


# ============================================================
# SMTP / EMAIL
# ============================================================

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

SMTP_USER=
SMTP_PASSWORD=

SMTP_FROM_EMAIL=
SMTP_FROM_NAME=


# ============================================================
# ALTERNATIVE SMTP CONFIGURATION
# ============================================================

# If port 587 cannot be used:
#
# SMTP_HOST=mail5005.site4now.net
# SMTP_PORT=465
# SMTP_SECURE=true
#
# Or, if your ISP blocks port 25:
#
# SMTP_HOST=mail.dialearnhub.com
# SMTP_PORT=8889
# SMTP_SECURE=false


# ============================================================
# WEBMAIL
# ============================================================

WEBMAIL_URL=


# ============================================================
# AUTHENTICATION
# ============================================================

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=


# ============================================================
# FRONTEND API
# ============================================================

# This variable belongs in the frontend environment,
# NOT the backend .env if the frontend is separately deployed.

VITE_API_BASE_URL=


# ============================================================
# FUTURE THIRD-PARTY INTEGRATIONS
# ============================================================

# Payment provider
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Storage provider
STORAGE_PROVIDER=
STORAGE_BUCKET=

# Classroom provider
CLASSROOM_PROVIDER=
CLASSROOM_API_KEY=
CLASSROOM_API_SECRET=
