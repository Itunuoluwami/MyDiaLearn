  tutor_accepted_at                        DateTime?              @db.Timestamptz(6)
  assignments                              assignments[]
  profiles_bookings_booked_byToprofiles    profiles               @relation("bookings_booked_byToprofiles", fields: [booked_by], references: [id], onDelete: SetDefault, onUpdate: NoAction)
  cancellation_policies                    cancellation_policies? @relation(fields: [cancellation_policy_id], references: [id], onUpdate: NoAction)
