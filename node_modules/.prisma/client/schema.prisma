// DiaLearn — Prisma schema
//
// INTROSPECTED from the live database, not hand-written. Regenerate with
// `npm run db:pull` after any schema change; do not edit models by hand.
//
// The schema was built by applying supabase/migrations/*.sql to this database
// through backend/scripts/schema-dryrun.mjs, over the compatibility layer in
// prisma/sql/000_compat.sql. Those SQL files remain the source of truth for
// DDL. Prisma cannot see the 68 functions, 123 RLS policies or 49 triggers
// that carry most of DiaLearn's business logic and all of its tenancy rules.
//
// ⚠️  Do NOT run `prisma migrate dev` against this database. Prisma diffs this
// file and writes SQL to make the database match, and it cannot see the
// objects above — so it will happily drop them. Introspect; do not migrate.
//
// Two constraints Prisma cannot model and therefore silently omits from the
// client, but which the database still enforces:
//   - bookings_no_tutor_overlap / bookings_no_student_overlap (GiST exclusion,
//     the rule that stops a tutor or a learner being double-booked)
//   - students_owner_present
//
// The `auth` and `storage` schemas come from the compatibility layer. They
// shrink as domains migrate: auth.users is replaced by AuthModule in Phase 2,
// and the storage policies move into the files module.

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public", "storage"]
}

model refresh_tokens {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String           @db.Uuid
  token_hash           String           @unique
  family_id            String           @db.Uuid
  expires_at           DateTime         @db.Timestamptz(6)
  revoked_at           DateTime?        @db.Timestamptz(6)
  revoked_reason       String?
  replaced_by          String?          @db.Uuid
  user_agent           String?
  ip                   String?
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  refresh_tokens       refresh_tokens?  @relation("refresh_tokensTorefresh_tokens", fields: [replaced_by], references: [id], onUpdate: NoAction)
  other_refresh_tokens refresh_tokens[] @relation("refresh_tokensTorefresh_tokens")
  users                users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "refresh_tokens_expiry_idx", where: raw("(revoked_at IS NULL)"))
  @@index([family_id], map: "refresh_tokens_family_idx")
  @@index([user_id], map: "refresh_tokens_user_idx")
  @@schema("auth")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String?               @unique
  encrypted_password  String?
  email_confirmed_at  DateTime?             @db.Timestamptz(6)
  raw_user_meta_data  Json                  @default("{}")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  last_sign_in_at     DateTime?             @db.Timestamptz(6)
  failed_login_count  Int                   @default(0)
  locked_until        DateTime?             @db.Timestamptz(6)
  password_changed_at DateTime?             @db.Timestamptz(6)
  refresh_tokens      refresh_tokens[]
  verification_tokens verification_tokens[]
  audit_logs          audit_logs[]
  profiles            profiles?
  tutor_agencies      tutor_agencies[]
  user_permissions    user_permissions[]
  user_roles          user_roles[]

  @@schema("auth")
}

model verification_tokens {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String               @db.Uuid
  purpose     verification_purpose
  token_hash  String               @unique
  expires_at  DateTime             @db.Timestamptz(6)
  consumed_at DateTime?            @db.Timestamptz(6)
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  users       users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, purpose], map: "verification_tokens_user_purpose_idx", where: raw("(consumed_at IS NULL)"))
  @@schema("auth")
}

